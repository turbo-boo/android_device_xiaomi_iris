# Double tap to wake: power/PowerModeExtension.cpp toggles the touch wakeup
# gesture through the xiaomi_touch mode ioctl on /dev/xiaomi-touch.
allow hal_power_default vendor_touchfeature_device:chr_file rw_file_perms;
