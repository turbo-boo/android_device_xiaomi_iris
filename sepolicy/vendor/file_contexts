# Fingerprint (FPC1020)
/data/vendor/fpc(/.*)?                                                    u:object_r:vendor_fingerprint_data_file:s0
/data/vendor/fpdump(/.*)?                                                 u:object_r:vendor_fingerprint_data_file_fpdump:s0
/mnt/vendor/persist/fpc(/.*)?                                             u:object_r:vendor_fingerprint_data_file:s0
/sys/bus/(soc|platform/soc)/devices/soc:fpc1020(/.*)?                     u:object_r:vendor_sysfs_fingerprint:s0
/sys/devices/(soc|platform/soc)/soc:fpc1020(/.*)?                         u:object_r:vendor_sysfs_fingerprint:s0
/(vendor|system/vendor)/bin/hw/android\.hardware\.biometrics\.fingerprint-service\.xiaomi u:object_r:hal_fingerprint_default_exec:s0

# NFC
/(vendor|system/vendor)/bin/hw/vendor\.nxp\.hardware\.nfc@2\.0-service     u:object_r:hal_nfc_default_exec:s0

# Sensors
/(vendor|system/vendor)/bin/hw/android\.hardware\.sensors-service\.xiaomi-multihal u:object_r:hal_sensors_default_exec:s0

# Thermal
/data/vendor/thermal(/.*)?                                                u:object_r:thermal_data_file:s0
/(vendor|system/vendor)/bin/mi_thermald                                   u:object_r:mi_thermald_exec:s0

# Wakeup sources (fpc_ttw_wl, sn-nci, NVTCapacitiveTouchScreen) read by
# system_suspend through /sys/class/wakeup
/sys/devices/platform/soc/soc:fpc1020/wakeup/wakeup[0-9]+(/.*)?               u:object_r:sysfs_wakeup:s0
/sys/devices/platform/soc/4c88000\.i2c/i2c-0/0-0028/wakeup/wakeup[0-9]+(/.*)? u:object_r:sysfs_wakeup:s0
/sys/devices/virtual/input/input[0-9]+/wakeup[0-9]+(/.*)?                     u:object_r:sysfs_wakeup:s0
