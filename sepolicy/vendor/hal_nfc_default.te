# NXP SN100: the eSE (FeliCa) is reached through the NFC controller, and
# /dev/assd is the secure element stream exported by the nq-nci driver.
allow hal_nfc_default secure_element_device:chr_file rw_file_perms;

# The NXP HAL records the firmware download state of the factory image
set_prop(hal_nfc_default, vendor_nfc_nq_prop)
