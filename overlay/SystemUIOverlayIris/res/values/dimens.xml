<!--
     SPDX-FileCopyrightText: The LineageOS Project
     SPDX-License-Identifier: Apache-2.0

     Status bar layout for the 74 x 103 px hole punch of this panel.
     status_bar_padding_top keeps the clock/icon row below the cutout; the corner content
     padding matches the MIUI value (50px) shipped in
     product/overlay/DevicesOverlay.apk (com.android.systemui overlay).
-->
<resources>
    <!-- the padding on the start of the statusbar -->
    <dimen name="status_bar_padding_start">3px</dimen>

    <!-- the padding on the end of the statusbar -->
    <dimen name="status_bar_padding_end">3px</dimen>

    <!-- the padding on the top of the statusbar (usually 0) -->
    <dimen name="status_bar_padding_top">18px</dimen>

    <!-- Default paddings for content around the corners. -->
    <dimen name="rounded_corner_content_padding">50px</dimen>

    <!-- Side (power button) fingerprint sensor. The sensor sits on the right hand edge,
         which is why x is the last pixel column of the 1080 px wide panel. -->
    <dimen name="physical_fingerprint_sensor_center_screen_location_x">1080px</dimen>
    <dimen name="physical_fingerprint_sensor_center_screen_location_y">955px</dimen>
</resources>
