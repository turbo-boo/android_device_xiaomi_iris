<resources>
    <!-- Automatic brightness. The lux levels and the hysteresis arrays below are taken
         verbatim from the stock vendor overlay of this device
         (vendor/overlay/FrameworksResTarget.apk). The framework reads
         config_autoBrightnessLcdBacklightValues on the legacy 1-255 scale
         (BrightnessSynchronizer.brightnessIntToFloat clamps anything above 255), so the stock
         12-bit values v (38-4095) are converted as round((v - 1) / 4094 * 254) + 1, which
         keeps every point within 0.002 of the stock float brightness. The stock lux -> nits
         array is deliberately not carried over: AOSP only uses it when
         config_screenBrightnessNits/config_screenBrightnessBacklight are fully populated,
         and no measured nits table exists for this panel. -->
    <bool name="config_automatic_brightness_available">true</bool>

    <integer-array name="config_autoBrightnessLevels">
        <item>1</item> <item>2</item> <item>4</item> <item>6</item> <item>8</item> <item>10</item> <item>15</item> <item>20</item>
        <item>25</item> <item>30</item> <item>35</item> <item>40</item> <item>45</item> <item>50</item> <item>55</item> <item>60</item>
        <item>65</item> <item>70</item> <item>75</item> <item>80</item> <item>85</item> <item>90</item> <item>95</item> <item>100</item>
        <item>120</item> <item>140</item> <item>160</item> <item>180</item> <item>200</item> <item>220</item> <item>240</item> <item>260</item>
        <item>280</item> <item>300</item> <item>320</item> <item>340</item> <item>360</item> <item>380</item> <item>400</item> <item>420</item>
        <item>440</item> <item>460</item> <item>480</item> <item>500</item> <item>700</item> <item>900</item> <item>1100</item> <item>1300</item>
        <item>1500</item> <item>1700</item> <item>1900</item> <item>2000</item> <item>2500</item> <item>3000</item> <item>3500</item> <item>4000</item>
        <item>4500</item>
    </integer-array>

    <integer-array name="config_autoBrightnessLcdBacklightValues">
        <item>3</item> <item>5</item> <item>9</item> <item>13</item> <item>16</item> <item>18</item> <item>25</item> <item>31</item>
        <item>42</item> <item>43</item> <item>43</item> <item>43</item> <item>44</item> <item>44</item> <item>44</item> <item>44</item>
        <item>44</item> <item>44</item> <item>45</item> <item>45</item> <item>46</item> <item>46</item> <item>46</item> <item>46</item>
        <item>46</item> <item>46</item> <item>47</item> <item>48</item> <item>49</item> <item>49</item> <item>50</item> <item>51</item>
        <item>51</item> <item>52</item> <item>53</item> <item>54</item> <item>54</item> <item>54</item> <item>55</item> <item>56</item>
        <item>57</item> <item>57</item> <item>58</item> <item>59</item> <item>60</item> <item>70</item> <item>82</item> <item>95</item>
        <item>108</item> <item>122</item> <item>137</item> <item>153</item> <item>158</item> <item>196</item> <item>219</item> <item>221</item>
        <item>227</item> <item>255</item>
    </integer-array>

    <!-- Ambient light hysteresis. Length of the threshold arrays must be one greater than
         config_ambientThresholdLevels. -->
    <integer-array name="config_ambientThresholdLevels">
        <item>2</item> <item>10</item> <item>30</item> <item>100</item> <item>800</item> <item>2000</item> <item>4000</item>
    </integer-array>

    <integer-array name="config_ambientBrighteningThresholds">
        <item>5</item> <item>5</item> <item>10</item> <item>30</item> <item>100</item> <item>400</item> <item>600</item> <item>1000</item>
    </integer-array>

    <integer-array name="config_ambientDarkeningThresholds">
        <item>800</item> <item>800</item> <item>500</item> <item>500</item> <item>500</item> <item>500</item> <item>500</item> <item>500</item>
    </integer-array>

    <!-- The stock overlay disables screen brightness hysteresis entirely (0). Keep the
         framework defaults instead so that AOSP's brightness controller can dampen the
         very flat mid-range of the backlight curve above. -->

    <integer name="config_autoBrightnessBrighteningLightDebounce">1000</integer>
    <integer name="config_autoBrightnessDarkeningLightDebounce">1000</integer>

    <fraction name="config_autoBrightnessAdjustmentMaxGamma">100%</fraction>

    <integer name="config_brightness_ramp_rate_fast">4933</integer>
    <integer name="config_brightness_ramp_rate_slow">3946</integer>

    <!-- Brightness range. The panel is driven through the AOSP 12-bit
         (0-4095) backlight scale. -->
    <integer name="config_screenBrightnessDim">24</integer>
    <item name="config_screenBrightnessDimFloat" format="float" type="dimen">0.00561798</item>
    <integer name="config_screenBrightnessSettingDefault">1072</integer>
    <item name="config_screenBrightnessSettingDefaultFloat" format="float" type="dimen">0.261602</item>
    <integer name="config_screenBrightnessSettingMaximum">4095</integer>
    <item name="config_screenBrightnessSettingMaximumFloat" format="float" type="dimen">1.0</item>
    <integer name="config_screenBrightnessSettingMinimum">8</integer>
    <item name="config_screenBrightnessSettingMinimumFloat" format="float" type="dimen">0.00170982</item>

    <integer name="config_shutdownBatteryTemperature">600</integer>

    <!-- The panel runs at 60 or 90 Hz. -->
    <integer name="config_defaultRefreshRate">0</integer>
    <integer name="config_defaultPeakRefreshRate">90</integer>

    <!-- Gesture navigation only, no capacitive keys. -->
    <bool name="config_showNavigationBar">true</bool>

    <!-- The headset detection is done through the input event device. -->
    <bool name="config_useDevInputEventForAudioJack">true</bool>

    <!-- Haptic patterns from the stock AOSP-style overlay
         (product/overlay/AospFrameworkResOverlay.apk). -->
    <integer-array name="config_longPressVibePattern">
        <item>0</item>
        <item>1</item>
        <item>75</item>
        <item>76</item>
    </integer-array>

    <integer-array name="config_virtualKeyVibePattern">
        <item>0</item>
        <item>30</item>
        <item>45</item>
        <item>53</item>
    </integer-array>

    <!-- Stock value (product/overlay/DevicesAndroidOverlay.apk), the framework default is
         10000 ms. -->
    <integer name="config_minimumScreenOffTimeout">6000</integer>

    <!-- Shutter sound is mandatory in Japan. -->
    <bool name="config_camera_sound_forced">true</bool>
    <bool name="config_cellBroadcastAppLinks">true</bool>

    <integer name="config_safe_media_volume_usb_mB">-1400</integer>

    <string name="config_mms_user_agent_profile_url" translatable="false">http://www.google.com/oha/rdf/ua-profile-kila.xml</string>

    <!-- The FPC sensor is integrated into the power button on the right hand edge. The AIDL HAL
         (android.hardware.biometrics.fingerprint-service.xiaomi) reports the side type from
         persist.vendor.fingerprint.type=side (vendor.prop). It reports a sensor location only
         when persist.vendor.fingerprint.sensor_location (x|y|radius) is set, which needs an
         on-device measurement of the button position; until then SystemUI has no side-fps
         indicator position. -->
    <bool name="config_is_powerbutton_fps">true</bool>

    <!-- 74 x 103 px (dp at 440 dpi) hole punch, centred on the 1080 px wide panel.
         Identical to the value shipped in the stock MIUI device overlay
         (product/overlay/DevicesAndroidOverlay.apk), which also sets
         notch_width=74px / notch_height=103px for SystemUI. -->
    <string name="config_mainBuiltInDisplayCutout" translatable="false">M 0,0 H -37 V 103 H 37 V 0 H 0 Z</string>
    <string name="config_mainBuiltInDisplayCutoutRectApproximation" translatable="false">M 0,0 H -37 V 103 H 37 V 0 H 0 Z</string>

    <!-- Power management -->
    <bool name="config_powerDecoupleAutoSuspendModeFromDisplay">true</bool>

    <!-- Doze. The stock component is MIUI's AOD service; use the AOSP/Lineage one. This is
         an LCD panel, so there is no always-on display. -->
    <string name="config_dozeComponent" translatable="false">com.android.systemui/com.android.systemui.doze.DozeService</string>
    <bool name="config_dozeAlwaysOnDisplayAvailable">false</bool>
    <bool name="config_dozeAlwaysOnEnabled">false</bool>
    <bool name="config_dozeAfterScreenOffByDefault">true</bool>

    <!-- Telephony: the device ships the Qualcomm IMS stack (au/KDDI VoLTE). -->
    <bool name="config_device_volte_available">true</bool>
    <bool name="config_carrier_volte_available">true</bool>
    <bool name="config_device_vt_available">true</bool>
    <bool name="config_device_wfc_ims_available">true</bool>
    <bool name="config_telephony5gNonStandalone">true</bool>
    <bool name="config_telephony5gStandalone">true</bool>

    <!-- IWLAN (VoWiFi) service packages, from the stock vendor overlay. -->
    <string name="config_wlan_data_service_package" translatable="false">vendor.qti.iwlan</string>
    <string name="config_wlan_network_service_package" translatable="false">vendor.qti.iwlan</string>
    <string name="config_qualified_networks_service_package" translatable="false">vendor.qti.iwlan</string>
</resources>
