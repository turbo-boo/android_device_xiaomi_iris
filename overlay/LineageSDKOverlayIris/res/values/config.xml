<resources>
    <!-- Defines the actions shown in advanced reboot submenu. -->
    <string-array name="config_restartActionsList">
        <item>restart</item>
        <item>restart_recovery</item>
        <item>restart_bootloader</item>
        <item>restart_fastboot</item>
    </string-array>

    <!-- Only the power and volume keys exist (no capacitive home/back/menu keys), so the
         key handler mask stays at volume only. -->
    <integer name="config_deviceHardwareKeys">64</integer>

    <!-- 20:9 panel (2400 x 1080). -->
    <bool name="config_haveHigherAspectRatioScreen">true</bool>

    <!-- No notification/battery LED (product/etc/device_features/iris.xml:
         support_led_light = false). -->
    <integer name="config_deviceLightCapabilities">0</integer>
</resources>
