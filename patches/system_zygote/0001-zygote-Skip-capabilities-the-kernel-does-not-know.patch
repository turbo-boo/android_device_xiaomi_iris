From d6dadb5e56c821e8dd44b13725d9de6e3085c733 Mon Sep 17 00:00:00 2001
From: xbill <xbill9@gmail.com>
Date: Tue, 27 Oct 2026 09:46:27 -0400
Subject: [PATCH] zygote: Skip capabilities the kernel does not know

Kernels older than 5.9 return EINVAL from PR_CAPBSET_READ for
CAP_PERFMON, CAP_BPF and CAP_CHECKPOINT_RESTORE (38-40). The child
process treated that as fatal and panicked while dropping the bounding
set ("Failed to check capability bound: GetCapBoundFailure(EINVAL)"),
so every native app zygote died at start on the 4.9 kernel. Chrome 156
runs its renderers in one, and system_server's process-start thread
then retried the dead socket for minutes, blocking all app starts.

A capability the kernel does not know cannot be in the bounding set,
so there is nothing to drop. The C++ zygote handles the same EINVAL
the same way.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Change-Id: I8f7f42c26aaa207d8a20171f4bae1c151a2ef6ec
---
 zygote/src/child_process.rs | 10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

diff --git a/zygote/src/child_process.rs b/zygote/src/child_process.rs
index f6ec741..c644d23 100644
--- a/zygote/src/child_process.rs
+++ b/zygote/src/child_process.rs
@@ -83,8 +83,14 @@ pub(crate) fn re_initialize(
     if let Some(cap_bound) = spawn_params.cap_bound {
         for flag in cap_bound.complement().iter() {
             let cap = Capability::try_from(flag.bits().trailing_zeros()).unwrap();
-            if cap::cap_within_bound(cap).expect("Failed to check capability bound") {
-                cap::cap_drop_bound(cap).expect("Failed to drop capability bound");
+            match cap::cap_within_bound(cap) {
+                Ok(true) => cap::cap_drop_bound(cap).expect("Failed to drop capability bound"),
+                Ok(false) => {}
+                // Kernels older than 5.9 do not know the newest capabilities and return EINVAL
+                // for them, so there is nothing to drop.
+                Err(cap::CapabilityError::GetCapBoundFailure(errno))
+                    if errno as i32 == libc::EINVAL => {}
+                Err(e) => panic!("Failed to check capability bound: {e:?}"),
             }
         }
     }
