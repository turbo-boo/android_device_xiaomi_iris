From d493eb1ee68cbd25e14851dae7e910559efee512 Mon Sep 17 00:00:00 2001
From: turbo-boo <59400127+turbo-boo@users.noreply.github.com>
Date: Mon, 9 Nov 2026 19:35:33 +0900
Subject: [PATCH] bpfloader: Skip the ring buffer test on kernels older than
 5.10

bpfRingbufProg.bpf is critical and only skipped on user builds, but its
map and program are declared with KVER(5, 10, 0) in bpfRingbufProg.c,
and BPF ring buffer maps need Linux 5.8. On a userdebug build for the
Redmi Note 10 JE (iris), which runs its stock 5.4 kernel, loading it
fails with EINVAL, bpfloader panics ("Error when loading
/system/etc/bpf/bpfRingbufProg.bpf: Invalid argument") and init reboots
with "reboot,bpfloader-failed" on every boot.

Give the map and the program the same 5.10 minimum here so that both are
skipped on older kernels.
---
 loader/bpfloader.rs | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/loader/bpfloader.rs b/loader/bpfloader.rs
index f23d882..c366128 100644
--- a/loader/bpfloader.rs
+++ b/loader/bpfloader.rs
@@ -49,6 +49,7 @@ const fn kver(a: u32, b: u32, c: u32) -> u32 {
 }
 
 const KVER_NONE: u32 = kver(0, 0, 0);
+const KVER_5_10: u32 = kver(5, 10, 0);
 const KVER_6_1: u32 = kver(6, 1, 0);
 const KVER_INF: u32 = 0xFFFFFFFF;
 
@@ -332,8 +333,8 @@ const FILE_ARR: &[BpfFileDesc] = &[
         filename: "/system/etc/bpf/bpfRingbufProg.bpf",
         critical: true,
         skip_on_user: true,
-        maps: &[MapDesc::new(GID_ROOT, PERM_GRW, "test_ringbuf")],
-        progs: &[ProgDesc::new(GID_ROOT, "skfilter_ringbuf_test")],
+        maps: &[MapDesc::new_kver(GID_ROOT, PERM_GRW, KVER_5_10, "test_ringbuf")],
+        progs: &[ProgDesc::new_kver(GID_ROOT, KVER_5_10, "skfilter_ringbuf_test")],
         ..BPF_FILE_DESC_DEFAULT
     },
 ];
-- 
