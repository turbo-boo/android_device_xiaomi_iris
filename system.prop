# System properties for the Redmi Note 10 JE (iris)
#
# Only hardware/framework tuning that must live on /system belongs here.
# Build identity, sounds, densities and MIUI specific properties are dropped.

# Audio
media.aac_51_output_enabled=true
media.stagefright.enable-aac=true
media.stagefright.enable-fma2dp=true
media.stagefright.enable-http=true
media.stagefright.enable-player=true
media.stagefright.enable-qcp=true
media.stagefright.enable-scan=true
media.stagefright.thumbnail.prefer_hw_codecs=true
mmp.enable.3g2=true
vendor.audio.usb.disable.sidetone=1

# Camera
# Only these (stock factory and QTI) apps see the auxiliary cameras 2-6, as on
# stock. Cameras 5 and 6 are MIUI internal (Xiaomi roles 100 and 101) and
# report an invalid zoomRatioRange of [FLT_MAX, 0], which makes Camera2 clients
# such as CameraX based Aperture crash while enumerating cameras.
vendor.camera.aux.packagelist=org.codeaurora.snapcam,com.xiaomi.runin,com.xiaomi.cameratest,com.xiaomi.factory.mmi
vendor.mm.enable.qcom_parser=16777215

# Connectivity
net.bt.name=Android
persist.cne.feature=1
persist.vendor.data.mode=concurrent
persist.vendor.bluetooth.modem_nv_support=true
persist.vendor.btstack.aac_frm_ctl.enabled=true

# Display
debug.sf.disable_backpressure=1
debug.sf.enable_hwc_vds=1

# Media (instance name resolved through ro.media.xml_variant.*)
ro.media.recorder-max-base-layer-fps=60

# Radio
persist.vendor.radio.redir_party_num=1
persist.vendor.radio.report_codec=1
ro.telephony.default_network=22,22
telephony.lteOnCdmaDevice=1

# Storage
external_storage.cross_user.enabled=1

# Telephony
persist.vendor.radio.enable_temp_dds=true

# QC framework value-adds
# Also selects the device's logical camera table in the CHI override; without
# it camx builds a GSI table whose camera 0 is a main + macro bokeh pair that
# never delivers frames.
ro.vendor.qti.va_aosp.support=1
